+ * SUCH DAMAGE.
+ */
+
+#ifndef _SYS_ESM_H_
+#define _SYS_ESM_H_
+
+#include <sys/cdefs.h>
+#include <sys/types.h>
+#include <linux/input.h>
+
+__BEGIN_DECLS
+
+/* ESM control commands */
+#define ESM_CTL_UNREGISTER_ALL  0
+#define ESM_CTL_GET_STATS       1
+
+/* ESM statistics structure */
+struct esm_stats {
+    unsigned long events_received;
+    unsigned long events_delivered;
+    unsigned long wakeups;
+};
+
+/*
+ * ESM event structure - returned by esm_wait()
+ *
+ * This structure includes both the file descriptor and the event,
+ * so the caller knows which device the event came from.
+ */
+struct esm_event {
+    int fd;                    /* File descriptor that generated this event */
+    struct input_event event;  /* The actual input event */
+};
+
+/**
+ * esm_register - Register an input device file descriptor with ESM
+ *
+ * @fd: File descriptor of input device (e.g., from open("/dev/input/event0"))
+ * @events: Event mask specifying which event types to receive
+ *
+ * Returns: 0 on success, -1 on error (errno set)
+ *
+ * Example:
+ *   int fd = open("/dev/input/event0", O_RDONLY | O_CLOEXEC);
+ *   if (esm_register(fd, (1 << EV_KEY) | (1 << EV_ABS)) < 0) {
+ *       perror("esm_register");
+ *   }
+ */
+int esm_register(int __fd, unsigned long __events);
+
+/**
+ * esm_wait - Wait for input events on registered devices
+ *
+ * @buffer: Buffer to receive esm_event structures
+ * @count: Maximum number of events to receive
+ * @timeout_ms: Timeout in milliseconds (-1 for infinite)
+ *
+ * Returns: Number of events received, -1 on error (errno set)
+ *
+ * This function blocks until events arrive or the timeout expires.
+ * Events are batched until EV_SYN/SYN_REPORT for proper synchronization.
+ *
+ * Each event includes the fd so you know which device it came from.
+ *
+ * Example:
+ *   struct esm_event events[32];
+ *   int n = esm_wait(events, 32, -1);  // Wait forever
+ *   if (n < 0) {
+ *       perror("esm_wait");
+ *   } else {
+ *       for (int i = 0; i < n; i++) {
+ *           printf("Event from fd %d: type=%d code=%d value=%d\n",
+ *                  events[i].fd, events[i].event.type,
+ *                  events[i].event.code, events[i].event.value);
+ *       }
+ *   }
+ */
+int esm_wait(struct esm_event* __buffer, size_t __count, int __timeout_ms);
+
+/**
+ * esm_ctl - Control ESM behavior
+ *
+ * @cmd: Command to execute
+ * @arg: Command-specific argument
+ *
+ * Returns: 0 on success, -1 on error (errno set)
+ *
+ * Commands:
+ *   ESM_CTL_UNREGISTER_ALL: Unregister all devices
+ *   ESM_CTL_GET_STATS: Get statistics (arg = pointer to esm_stats)
+ */
+int esm_ctl(int __cmd, unsigned long __arg);
+
+/**
+ * is_in_esm_wait - Check if a thread is blocked in esm_wait()
+ *
+ * @tid: Thread ID to check
+ *
+ * Returns: 1 if thread is in esm_wait(), 0 if not, -1 on error (errno set)
+ *
+ * This function allows checking if a specific thread is currently blocked
+ * waiting for ESM events. Useful for debugging and monitoring.
+ */
+int is_in_esm_wait(pid_t __tid);
+
+__END_DECLS
+
+#endif /* _SYS_ESM_H_ */
