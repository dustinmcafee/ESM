diff --git a/kernel/Android.mk b/kernel/Android.mk
new file mode 100644
index 0000000..99d9609
--- /dev/null
+++ b/kernel/Android.mk
@@ -0,0 +1,8 @@
+LOCAL_PATH := $(call my-dir)
+
+# ESM Kernel Build Integration
+# The kernel must be built first using: ./build.sh -K
+# This copies the kernel to the redbull-kernel prebuilt directory
+
+# Use the ESM kernel from the redbull-kernel directory where build_esm_kernel.sh copies it
+TARGET_PREBUILT_KERNEL := device/google/redbull-kernel/Image.lz4-dtb
