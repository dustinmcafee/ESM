+
+#define LOG_TAG "Watchdog-JNI"
+
+#include <nativehelper/JNIHelp.h>
+#include "jni.h"
+
+#include <errno.h>
+#include <unistd.h>
+#include <sys/syscall.h>
+
+namespace android {
+
+static jint com_android_server_Watchdog_isInEsmWait(JNIEnv* env, jobject /* clazz */, jint tid) {
+#ifdef __NR_is_in_esm_wait
+    int result = syscall(__NR_is_in_esm_wait, tid);
+    if (result < 0) {
+        // Return 0 on error - assume not in ESM wait
+        return 0;
+    }
+    return result;
+#else
+    // Syscall not available on this architecture
+    return 0;
+#endif
+}
+
+static const JNINativeMethod gMethods[] = {
+    {"nativeIsInEsmWait", "(I)I", (void*)com_android_server_Watchdog_isInEsmWait},
+};
+
+int register_android_server_Watchdog(JNIEnv* env) {
+    return jniRegisterNativeMethods(env, "com/android/server/Watchdog",
+            gMethods, NELEM(gMethods));
+}
+
+} // namespace android
