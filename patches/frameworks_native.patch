 void InputReader::monitor() {
+    // ESM: Check if InputReader thread is in ESM wait state
+    // If so, it's alive and healthy - no need to wake/wait
+    if (mThread) {
+        pid_t tid = mThread->getTid();
+#ifdef __NR_is_in_esm_wait
+        int result = syscall(__NR_is_in_esm_wait, tid);
+        if (result == 1) {
+            // Thread is legitimately waiting in esm_wait() - it's alive
+            ALOGV("InputReader thread %d is in ESM wait - healthy", tid);
+            mEventHub->monitor();
+            return;
+        }
+#endif
+    }
+
     // Acquire and release the lock to ensure that the reader has not deadlocked.
     std::unique_lock<std::mutex> lock(mLock);
     mEventHub->wake();
