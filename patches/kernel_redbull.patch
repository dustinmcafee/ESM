diff --git a/include/linux/esm.h b/include/linux/esm.h
new file mode 100644
index 00000000..50b68da1
--- /dev/null
+++ b/include/linux/esm.h
@@ -0,0 +1,35 @@
+/*
+ * ESM (Event Stream Model) - Kernel header
+ *
+ * This file defines the kernel-side ESM interface.
+ */
+
+#ifndef _LINUX_ESM_H
+#define _LINUX_ESM_H
+
+#include <linux/input.h>
+
+/* ESM control commands for esm_ctl() */
+#define ESM_CTL_UNREGISTER_ALL  0
+#define ESM_CTL_GET_STATS       1
+
+/* ESM statistics structure */
+struct esm_stats {
+	unsigned long events_received;
+	unsigned long events_delivered;
+	unsigned long wakeups;
+};
+
+#ifdef __KERNEL__
+
+/* Kernel-only functions */
+int esm_push_event(struct file *filp, struct input_event *event);
+
+/* Cleanup functions */
+struct task_struct;
+void esm_exit_task(struct task_struct *task);
+void esm_file_close(struct file *filp);
+
+#endif /* __KERNEL__ */
+
+#endif /* _LINUX_ESM_H */
