diff --git a/include/uapi/linux/esm.h b/include/uapi/linux/esm.h
new file mode 100644
index 00000000..52fe20ae
--- /dev/null
+++ b/include/uapi/linux/esm.h
@@ -0,0 +1,35 @@
+/*
+ * ESM (Event Stream Model) - Userspace API
+ *
+ * This file defines the userspace interface for ESM.
+ */
+
+#ifndef _UAPI_LINUX_ESM_H
+#define _UAPI_LINUX_ESM_H
+
+#include <linux/types.h>
+#include <linux/input.h>
+
+/* ESM control commands for esm_ctl() */
+#define ESM_CTL_UNREGISTER_ALL  0
+#define ESM_CTL_GET_STATS       1
+
+/* ESM statistics structure */
+struct esm_stats {
+	__u64 events_received;
+	__u64 events_delivered;
+	__u64 wakeups;
+};
+
+/*
+ * ESM event structure - returned by esm_wait()
+ *
+ * This structure includes both the file descriptor and the event,
+ * so the caller knows which device the event came from.
+ */
+struct esm_event {
+	int fd;                    /* File descriptor that generated this event */
+	struct input_event event;  /* The actual input event */
+};
+
+#endif /* _UAPI_LINUX_ESM_H */
